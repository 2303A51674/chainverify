{
  "name": "chainverify",
  "version": "1.0.0",
  "description": "Blockchain product authenticity verification (Solidity + Hardhat + Express)",
  "main": "server/server.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "dataset": "node scripts/make-dataset.js",
    "seed": "node scripts/seed.js",
    "start": "node server/server.js"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.9",
    "ethers": "^6.17.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.29.1"
  }
}
