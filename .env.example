# ---- Local development needs NO .env at all (uses Hardhat's default dev account) ----
# ---- Testnet / production ----
NETWORK=amoy
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=0xYOUR_TESTNET_WALLET_PRIVATE_KEY   # a throwaway wallet funded with test POL – never reuse a real wallet
ADMIN_KEY=choose-a-long-random-string           # password for the Manufacturer tab
NODE_ENV=production
# CONTRACT_ADDRESS=0x...                         # optional override
# SCANS_FILE=/var/data/scans.json                # persistent disk path in production
